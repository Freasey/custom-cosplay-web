{
  // Situs statis (folder out/) plus Worker kecil untuk halaman admin. Deploy: `npx wrangler deploy`.
  // `name` harus sama dengan nama proyek di dashboard Cloudflare.
  "name": "custom-cosplay-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Hanya rute ini yang melewati Worker. Halaman publik tetap dilayani langsung sebagai file statis.
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  // Variabel dan secret yang diisi di dashboard (ADMIN_EMAIL, ADMIN_PASSWORD, BLOB_READ_WRITE_TOKEN,
  // DEPLOY_HOOK_URL) tidak ditimpa saat deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
